print("[Master Hub] Initialising Absolute Solver Engine...")

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()

local HAT_NAME = "Accessory (113_BuildABoatforaTopHat)" 
local BACKPACK_NAME = "Accessory (102_DualoftheHeights)"

local hat = Character:WaitForChild(HAT_NAME, 5)
local backpack = Character:WaitForChild(BACKPACK_NAME, 5)

local hatHandle = hat and hat:FindFirstChild("Handle")
local backpackHandle = backpack and backpack:FindFirstChild("Handle")

if hatHandle then 
	hatHandle.Transparency = 1 
	print("[Master Hub] Hat hidden safely.") 
end
if backpackHandle then 
	backpackHandle.Transparency = 1 
	print("[Master Hub] Backpack hidden safely.") 
end

local URL_GUI_LOAD    = "https://raw.githubusercontent.com/DxKVr5/AbsoluteSolver-Script/refs/heads/main/LoadUI"
local URL_ACTIVATE    = "https://raw.githubusercontent.com/DxKVr5/AbsoluteSolver-Script/refs/heads/main/ActivateSolver"

local success, err = pcall(function()
    _G.LoadSolverGui   = loadstring(game:HttpGet(URL_GUI_LOAD))
    _G.SolverActivate  = loadstring(game:HttpGet(URL_ACTIVATE))
end)

if not success then
    warn("[Master Hub] Critical Network Error Fetching Links: " .. tostring(err))
    return
end

if _G.LoadSolverGui then
    print("[Master Hub] Launching GUI Panel...")
    _G.LoadSolverGui()
    print("[Master Hub] Absolute Solver Hub Fully Loaded! Use buttons to activate.")
else
    warn("[Master Hub] Failed to compile LoadUI script from GitHub path.")
end
