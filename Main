--// Absolute Solver Master Hub Bootstrapper \\--
print("[Master Hub] Initialising Bare-Minimum Loader...")

--// Character Setup \\--
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()

-- Target asset strings matching your equipped inventory list
local HAT_NAME = "Accessory (113_BuildABoatforaTopHat)" 
local BACKPACK_NAME = "Accessory (102_DualoftheHeights)"

--// 1. INSTANT CLOAKING AREA (The only work Main does) \\--
local hat = Character:WaitForChild(HAT_NAME, 5)
local backpack = Character:WaitForChild(BACKPACK_NAME, 5)

local hatHandle = hat and hat:FindFirstChild("Handle")
local backpackHandle = backpack and backpack:FindFirstChild("Handle")

if hatHandle then hatHandle.Transparency = 1 print("[Master] Hat hidden.") end
if backpackHandle then backpackHandle.Transparency = 1 print("[Master] Backpack hidden.") end

--// 2. REMOTE HANDOFF ENGINE \\--
-- Main hands off 100% of the remaining workload to your GitHub repository files instantly
local URL_GUI_LOAD = "https://raw.githubusercontent.com/DxKVr5/AbsoluteSolver-Script/refs/heads/main/LoadUI"

local launchHub, err = pcall(function()
	loadstring(game:HttpGet(URL_GUI_LOAD))()
end)

if launchHub then
	print("[Master Hub] Workload passed to LoadUI successfully!")
else
	warn("[Master Hub] Critical Error calling remote files: " .. tostring(err))
end
