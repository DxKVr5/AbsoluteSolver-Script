--// Services \\--
local RunService = game:GetService("RunService")

--// Character \\--
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local Humanoid = Character:WaitForChild("Humanoid")
local hrp = Character:WaitForChild("HumanoidRootPart")
local HAT_NAME = "Accessory (113_BuildABoatforaTopHat)"

--// Fix: Add () to compile the HttpGet function into executable code instantly \\--
local SolverActivate = loadstring(game:HttpGet("https://raw.githubusercontent.com/DxKVr5/AbsoluteSolver-Script/refs/heads/main/SolverActivate"))()
local ABSOLUTESOLVER = _G.ABSOLUTESOLVER

--// ActivateSolver \\--
task.spawn(function()
	if ABSOLUTESOLVER == true then
		-- 1. Fire the visual CFrame animation data table sequence
		if SolverActivate then
			SolverActivate()
		else
			warn("[Absolute Solver] Animation sub-script failed to execute!")
		end
		
		-- 2. Wait for your arm movement timeline to reach peak pose
		task.wait(0.43)
		
		-- 3. Turn on the background global variable so the Hider script spawns the mesh
		_G.SolverSymbol = true
		
		-- 4. Locate the flat parts inside the hat and flash it visible to the server
		local hat = Character:FindFirstChild(HAT_NAME)
		local hatHandle = hat and hat:FindFirstChild("Handle")
		local solverDisc = hatHandle and hatHandle:FindFirstChild("AbsoluteSolverDisc")
		
		if solverDisc then
			solverDisc.Transparency = 0 -- Drops transparency to reveal the seamless SurfaceGuis
			print("[Absolute Solver] Hand glyph successfully uncloaked.")
		end
	end
end)
