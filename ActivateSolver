local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

--// Character Setup \\--
local LocalPlayer = Players.LocalPlayer
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local Humanoid = Character:WaitForChild("Humanoid")
local HAT_NAME = "Accessory (113_BuildABoatforaTopHat)"

local ABSOLUTESOLVER = _G.ABSOLUTESOLVER

--// 1. BUILT-IN KEYFRAME DATA (No loadstring needed!) \\--
local kf0    = CFrame.new() -- Default resting pose angle at 0 seconds
local kf0_3  = CFrame.Angles(math.rad(32.315), math.rad(57.124), math.rad(52.999))
local kf0_43 = CFrame.Angles(math.rad(-11.516), math.rad(-25.726), math.rad(10.485))

--// 2. TIMED INTERPOLATION ENGINE \\--
local function playCFrameAnimation()
	local torso = Character:FindFirstChild("Torso")
	local rs = torso and torso:FindFirstChild("Right Shoulder")
	
	if not rs then
		warn("[Absolute Solver] Error: R6 Right Shoulder joint missing.")
		return
	end

	-- Save your starting joint position so we can offset it safely
	local defaultC0 = CFrame.new(1, 0.5, 0)
	
	print("[Absolute Solver] Initialising built-in playback track...")
	
	-- --- TRACK PHASE 1: 0.0 to 0.3 seconds ---
	local duration1 = 0.3
	local elapsed1 = 0
	while elapsed1 < duration1 do
		local dt = RunService.Heartbeat:Wait()
		elapsed1 = math.min(elapsed1 + dt, duration1)
		
		local alpha = elapsed1 / duration1
		local currentPose = kf0:Lerp(kf0_3, alpha)
		
		rs.C0 = defaultC0 * currentPose
	end

	-- --- TRACK PHASE 2: 0.3 to 0.433 seconds ---
	local duration2 = 0.133 -- Total window length from 0.300 to 0.433
	local elapsed2 = 0
	while elapsed2 < duration2 do
		local dt = RunService.Heartbeat:Wait()
		elapsed2 = math.min(elapsed2 + dt, duration2)
		
		local alpha = elapsed2 / duration2
		local currentPose = kf0_3:Lerp(kf0_43, alpha)
		
		rs.C0 = defaultC0 * currentPose
	end

	-- --- TRACK PHASE 3: Absolute Terminal Frame (0.433s Lock) ---
	rs.C0 = defaultC0 * kf0_43
end

--// 3. MAIN RUNTIME TIMELINE EXECUTOR \\--
task.spawn(function()
	if ABSOLUTESOLVER == true then
		-- Phase A: Fire your precise timed keyframe loop sequence instantly
		playCFrameAnimation()
		
		-- Phase B: Wait for your exact animation tracking timeline to reach peak extension
		task.wait(0.433)
		
		-- Phase C: Turn on the background global variable so your Core Engine starts rendering
		_G.SolverSymbol = true
		
		-- Phase D: Locate the flat parts inside your designated Top Hat accessory and uncloak it
		local hat = Character:FindFirstChild(HAT_NAME)
		local hatHandle = hat and hat:FindFirstChild("Handle")
		local solverDisc = hatHandle and hatHandle:FindFirstChild("AbsoluteSolverDisc")
		
		if solverDisc then
			solverDisc.Transparency = 0 -- Flash the dual-sided seamless SurfaceGuis visible globally!
			print("[Absolute Solver] Visual glyphs deployed in sync at 0.433s.")
		else
			warn("[Absolute Solver Failure] Missing 'AbsoluteSolverDisc' target inside Hat Handle.")
		end
	end
end)
