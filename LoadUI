--// Global System States Initialization \\--
_G.ABSOLUTESOLVER = false
_G.SolverSymbol = false
_G.NULLVOID = false

--// Centralized Cloud Script Handoff Engine \\--
local function loadPipelineScripts()
	print("[Solver UI] Connecting to cloud pipeline...")
	local repo = "https://raw.githubusercontent.com/DxKVr5/AbsoluteSolver-Script/refs/heads/main/"
	
	local success, err = pcall(function()
		-- Pre-compile sub-scripts into executable global functions
		_G.RunCoreEngine    = loadstring(game:HttpGet(repo .. "CoreMorphEngine"))()
		_G.RunActivateAnim  = loadstring(game:HttpGet(repo .. "ActivateSolver"))()
		-- _G.RunChokeAttack = loadstring(game:HttpGet(repo .. "ChokeSkill"))
		-- _G.RunFlingAttack = loadstring(game:HttpGet(repo .. "FlingSkill"))
	end)
	
	if success then
		print("[Solver UI] Cloud binaries compiled smoothly into RAM.")
		-- Instantly boot your background cloaking/morph engine loops!
		if _G.RunCoreEngine then task.spawn(_G.RunCoreEngine) end
	else
		warn("[Solver UI] Pipeline connection failed: " .. tostring(err))
	end
end

-- Execute the download function as soon as the interface registers on screen
loadPipelineScripts()

--// Centralized UI Event Triggers \\--

-- Turning the Solver ON
Off.MouseButton1Click:Connect(function()
	Off.Visible = false
	On.Visible = true
	_G.ABSOLUTESOLVER = true
	
	-- Fire your custom R6/R15 animation sequence and visual hand triggers
	if _G.RunActivateAnim then
		task.spawn(_G.RunActivateAnim)
	else
		warn("[Solver UI Error] Activation script compiled chunk is empty.")
	end
end)

-- Turning the Solver OFF
On.MouseButton1Click:Connect(function()
	On.Visible = false
	Off.Visible = true
	_G.ABSOLUTESOLVER = false
	
	-- Disable background visual systems instantly via state tracking
	_G.SolverSymbol = false
	_G.NULLVOID = false
end)
