local function KNHCFX_fake_script() -- Off.On 
	local script = Instance.new('LocalScript', Off)

	local button = script.Parent
	local ON = button.Parent.On
	ABSOLUTESOLVER = _G.ABSOLUTESOLVER
	
	button.MouseButton1Click:Connect(function()
		button.Visible = false
		ON.Visible = true
		_G.ABSOLUTESOLVER = true
		
	end)
end
coroutine.wrap(KNHCFX_fake_script)()
